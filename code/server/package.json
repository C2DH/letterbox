{
  "name": "@letterbox/server",
  "version": "0.0.1",
  "main": "build/index.js",
  "scripts": {
    "clean": "rimraf build .eslintcache",
    "build": "npm run clean && npm run generate && tsc && npm run assets",
    "init": "tsx src/bin/neo4j-schema",
    "start": "npm run init && nodemon",
    "assets": "copyfiles -u 2 src/graphql/schema.graphql build/graphql/",
    "lint": "eslint 'src/**/*.ts' --ignore-pattern src/graphql/generated/** --cache",
    "test": "vitest",
    "generate": "graphql-codegen",
    "dataset:import": "tsx src/bin/dataset-import",
    "dataset:index": "tsx src/bin/dataset-index",
    "dataset:import-tags": "tsx src/bin/dataset-import-tags"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@elastic/elasticsearch": "8.19.2",
    "@graphql-tools/delegate": "^12.3.2",
    "@graphql-tools/utils": "^13.2.1",
    "@graphql-tools/wrap": "^11.2.4",
    "@hapi/boom": "^10.0.1",
    "@neo4j/graphql": "^7.6.7",
    "@ouestware/async": "^0.0.1-alpha.3",
    "@ouestware/facets": "^0.0.1-alpha.4",
    "@ouestware/facets-server": "^0.0.1-alpha.5",
    "@ouestware/node-elasticsearch": "^0.0.1-alpha.7",
    "@ouestware/node-logger": "^0.0.1-aplha.2",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "globby": "16.2.4",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.6",
    "graphql-type-json": "^0.3.2",
    "neo4j-driver": "^6.3.0",
    "object-hash": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "talisman": "^1.1.4",
    "ts-stream": "^3.0.0",
    "tsyringe": "^4.8.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript-resolvers": "^7.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6"
  }
}
