{
  "extends": "../tsconfig.base.json",
  "include": ["./src"],
  "compilerOptions": {
    "declaration": false,
    "declarationDir": null,
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "outDir": "build",
    "paths": {
      "~/*": ["./src/*"]
    },
    "rootDir": "./src",
    "strictPropertyInitialization": false
  }
}
